<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:EnigmaBenchmarkAvalonia"
        x:Class="EnigmaBenchmarkAvalonia.MainWindow"
        Title="Enigma Benchmark — WWII German Cipher × Modern Compute"
        Width="1040" Height="820"
        MinWidth="900" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="#0E1116">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*" Margin="18">

        <!-- ── Header: title + About ───────────────────────────────────────── -->
        <Grid Grid.Row="0" Margin="0,0,0,14" ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" Orientation="Vertical">
                <TextBlock Text="EnigmaBenchmark"
                           FontSize="26" FontWeight="Bold" Foreground="#FFD060" />
                <TextBlock Text="二戰德國頂級密碼 × 你書桌上這顆 GPU"
                           FontSize="13" Foreground="#8A93A0" Margin="0,2,0,0" />
            </StackPanel>
            <Button Grid.Column="1" x:Name="AboutBtn"
                    Content="About  ⓘ" Padding="12,4"
                    VerticalAlignment="Top"
                    ToolTip.Tip="Open readme.html in browser" />
        </Grid>

        <!-- ── Controls ────────────────────────────────────────────────────── -->
        <Border Grid.Row="1" Background="#151A22" BorderBrush="#1F2430"
                BorderThickness="1" CornerRadius="6"
                Padding="14,10" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock VerticalAlignment="Center" Text="Cipher:" Foreground="#8A93A0" />
                <ComboBox x:Name="CipherBox" SelectedIndex="0" Width="160" IsEnabled="False">
                    <ComboBoxItem Content="Enigma M3 (Wehrmacht)" />
                    <ComboBoxItem Content="Enigma M4 (U-Boot Shark) — coming" />
                    <ComboBoxItem Content="Lorenz SZ40 (Tunny) — coming" />
                </ComboBox>
                <TextBlock VerticalAlignment="Center" Text="Scope:"
                           Foreground="#8A93A0" Margin="10,0,0,0" />
                <ComboBox x:Name="ScopeBox" SelectedIndex="0" Width="110">
                    <ComboBoxItem Content="Quick" />
                    <ComboBoxItem Content="Normal" />
                    <ComboBoxItem Content="Hard" />
                    <ComboBoxItem Content="Extreme" />
                </ComboBox>
                <Button x:Name="StartBtn" Content="Start Benchmark"
                        Padding="18,6" Margin="10,0,0,0"
                        Background="#FFD060" Foreground="#101418"
                        FontWeight="SemiBold" />
                <TextBlock x:Name="StatusLabel" VerticalAlignment="Center"
                           Text="Ready" Foreground="#80FF80" Margin="14,0,0,0" />
            </StackPanel>
        </Border>

        <!-- ── Cipher reveal panel ─────────────────────────────────────────── -->
        <local:CipherRevealPanel Grid.Row="2" x:Name="Reveal" Margin="0,0,0,14" />

        <!-- ── Historical comparison card (hidden until end of run) ────────── -->
        <Border Grid.Row="3" x:Name="HistCard" IsVisible="False"
                Background="#151A22" BorderBrush="#FFD060" BorderThickness="1"
                CornerRadius="6" Padding="18,14" Margin="0,0,0,14">
            <Grid ColumnDefinitions="*,Auto,*" RowDefinitions="Auto,Auto,Auto">

                <!-- Header row -->
                <TextBlock Grid.Column="0" Grid.Row="0" Text="THEN"
                           FontSize="11" FontWeight="SemiBold" Foreground="#6A7280"
                           HorizontalAlignment="Center" />
                <TextBlock Grid.Column="2" Grid.Row="0" Text="NOW"
                           FontSize="11" FontWeight="SemiBold" Foreground="#6A7280"
                           HorizontalAlignment="Center" />

                <!-- Labels -->
                <TextBlock Grid.Column="0" Grid.Row="1"
                           x:Name="HistThenLabel"
                           Text="Bletchley Park (1940s)"
                           FontSize="14" Foreground="#D8DEE4"
                           HorizontalAlignment="Center" Margin="0,2,0,0" />
                <TextBlock Grid.Column="2" Grid.Row="1"
                           x:Name="HistNowLabel"
                           Text="Your GPU (2025)"
                           FontSize="14" Foreground="#D8DEE4"
                           HorizontalAlignment="Center" Margin="0,2,0,0" />

                <!-- Numbers -->
                <TextBlock Grid.Column="0" Grid.Row="2"
                           x:Name="HistThenTime"
                           Text="~15 min"
                           FontSize="34" FontWeight="Bold"
                           FontFamily="Consolas,Cascadia Mono,monospace"
                           Foreground="#FFD060"
                           HorizontalAlignment="Center" Margin="0,4,0,0" />

                <!-- Divider with ratio -->
                <StackPanel Grid.Column="1" Grid.Row="2" Orientation="Vertical"
                            VerticalAlignment="Center" Margin="24,0">
                    <TextBlock x:Name="HistRatio" Text="3,600×"
                               FontSize="20" FontWeight="Bold"
                               FontFamily="Consolas,Cascadia Mono,monospace"
                               Foreground="#80FF80"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="faster"
                               FontSize="11" Foreground="#6A7280"
                               HorizontalAlignment="Center" />
                </StackPanel>

                <TextBlock Grid.Column="2" Grid.Row="2"
                           x:Name="HistNowTime"
                           Text="0.250 s"
                           FontSize="34" FontWeight="Bold"
                           FontFamily="Consolas,Cascadia Mono,monospace"
                           Foreground="#80FF80"
                           HorizontalAlignment="Center" Margin="0,4,0,0" />
            </Grid>
        </Border>

        <!-- ── BenchmarkControl (invisible host for render-thread GPU lease) ── -->
        <local:BenchmarkControl Grid.Row="4" x:Name="Bench" Width="1" Height="1" />

        <!-- ── Log ─────────────────────────────────────────────────────────── -->
        <Border Grid.Row="5" BorderBrush="#1F2430" BorderThickness="1"
                Background="#101418" CornerRadius="6">
            <ScrollViewer x:Name="LogScroll">
                <TextBlock x:Name="Log"
                           FontFamily="Consolas,Cascadia Mono,monospace"
                           FontSize="12"
                           Foreground="#D8DEE4"
                           Padding="14,10"
                           TextWrapping="NoWrap" />
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
