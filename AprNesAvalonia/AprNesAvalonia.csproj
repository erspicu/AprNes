<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>annotations</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AssemblyName>AprNesAvalonia</AssemblyName>
    <RootNamespace>AprNesAvalonia</RootNamespace>
    <!-- Cross-platform RuntimeIdentifiers (Phase 0 of cross-platform plan).
         Plan: MD/Avalonia/cross_platform_audio_gamepad_plan.md
         Windows keeps existing Win32 backends; Linux/macOS gain
         Hexa.NET.MiniAudio (audio) + Hexa.NET.SDL3 (gamepad). -->
    <RuntimeIdentifiers>win-x64;linux-x64;linux-arm64;osx-arm64</RuntimeIdentifiers>
    <!-- .NET 10: full JIT tiered compilation + PGO -->
    <TieredCompilation>true</TieredCompilation>
    <TieredPGO>true</TieredPGO>
    <!-- CRT runtime dispatch: all three backends compiled (Scalar + SIMD + GPU) -->
    <!-- HD_NTSC: NTSC pipeline at 2048 samples/scanline (12× Fsc oversampling).
         NetFx omits this symbol → keeps 1024-sample path with current performance. -->
    <DefineConstants>$(DefineConstants);CRT_SIMD_AVAILABLE;CRT_GPU_AVAILABLE;HD_NTSC</DefineConstants>
    <!-- ConfigWindow uses parameterized constructor only; XAML runtime loader not used -->
    <NoWarn>$(NoWarn);AVLN3001</NoWarn>
    <!-- Build timestamp embedded into assembly metadata (immune to copy/rename) -->
    <SourceRevisionId>build$([System.DateTime]::Now.ToString("yyyyMMdd-HHmmss"))</SourceRevisionId>
  </PropertyGroup>

  <!-- NesCore: 直接引用 AprNes 全部源碼，不再使用本地 NesCoreNET 副本 -->
  <ItemGroup>
    <!-- 排除本地 NesCoreNET 副本 -->
    <Compile Remove="NesCoreNET/**/*.cs" />

    <!-- 引用 AprNes NesCore 全部源碼 -->
    <Compile Include="../AprNes/NesCore/*.cs" Link="NesCore/%(Filename)%(Extension)" />
    <Compile Include="../AprNes/NesCore/Mapper/*.cs" Link="NesCore/Mapper/%(Filename)%(Extension)" />
    <Compile Include="../AprNes/NesCore/AudioPlus/*.cs" Link="NesCore/AudioPlus/%(Filename)%(Extension)" />
    <!-- NTSC_CRT: runtime dispatch (Phase 1). All three files compiled.
         Shared.cs provides partial-class dispatcher; Scalar + Simd impls
         coexist as independent static classes (CrtScreenScalar / CrtScreenSimd).
         Runtime switch via NesCore.Crt_SetBackend() or crt-strategy CLI. -->
    <Compile Include="../AprNes/NesCore/NTSC_CRT/*.cs"
             Link="NesCore/NTSC_CRT/%(Filename)%(Extension)" />

    <!-- CRT GPU shaders (copy to output for File.ReadAllText at runtime) -->
    <None Include="Shaders\*.sksl">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>

    <!-- 外部工具 -->
    <Compile Include="../AprNes/tool/WaveOutPlayer.cs" Link="Platform/WaveOutPlayer.cs" />
    <Compile Include="../AprNes/tool/VideoRecorder.cs" Link="Tool/VideoRecorder.cs" />
    <Compile Include="../AprNes/tool/AudioRecorder.cs" Link="Tool/AudioRecorder.cs" />

    <!-- 手把 (DirectInput8 + XInput, pure P/Invoke) -->
    <Compile Include="../AprNes/tool/NativeAPIShare.cs" Link="Platform/NativeAPIShare.cs" />
    <Compile Include="../AprNes/tool/DirectInputHelper.cs" Link="Platform/DirectInputHelper.cs" />
    <Compile Include="../AprNes/tool/joystick.cs" Link="Platform/joystick.cs" />

    <!-- 共用 enum -->
    <Compile Include="../AprNes/tool/ResizeFilter.cs" Link="Tool/ResizeFilter.cs" />

    <!-- 濾鏡 (pure unsafe pointer, 無 WinForms 依賴) -->
    <Compile Include="../AprNes/tool/libXBRz.cs" Link="Tool/libXBRz.cs" />
    <Compile Include="../AprNes/tool/Scalex.cs" Link="Tool/Scalex.cs" />
    <Compile Include="../AprNes/tool/LibScanline.cs" Link="Tool/LibScanline.cs" />

    <!-- Phase 5.6: shared two-stage resize pipeline (composes the three filters above).
         Single source of truth — was duplicated as AprNesAvalonia/Platform/RenderPipeline.cs
         and AprNes/tool/Render_resize.cs (NetFx version still wraps this with GDI bits). -->
    <Compile Include="../AprNes/tool/RenderPipeline.cs" Link="Tool/RenderPipeline.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.13" />
    <PackageReference Include="SkiaSharp" Version="3.119.3-preview.1.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="3.119.3-preview.1.1" />
    <!-- Linux/macOS need explicit 3.119 native-asset overrides; otherwise
         Avalonia.Skia's transitive 2.88.7 wins and the runtime aborts with
         "native libSkiaSharp 88.1 is incompatible, expected [119.0, 120.0)". -->
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="3.119.3-preview.1.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.macOS" Version="3.119.3-preview.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.13" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.13" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.13" />
    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.13">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <!-- Cross-platform native bindings (Phase 0). Linux + macOS only;
         Windows keeps using its hand-written WaveOut + DirectInput8/XInput
         backends. Both packages ship prebuilt native binaries
         (libminiaudio.so/.dylib, libSDL3.so/.dylib) inside the .nupkg
         under runtimes/{rid}/native/ — published apps need no extra
         user-side install. -->
    <PackageReference Include="Hexa.NET.MiniAudio" Version="1.0.1" />
    <PackageReference Include="Hexa.NET.SDL3"      Version="1.2.17" />
  </ItemGroup>

  <!-- Publish-only content (release packaging). Copied to publish dir,
       NOT to bin/Debug or bin/Release on a normal build. Adding more files
       under PublishContent/ will auto-include them on next publish. -->
  <ItemGroup>
    <None Include="PublishContent\**\*.*" Exclude="PublishContent\**\.gitkeep">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <Link>%(RecursiveDir)%(Filename)%(Extension)</Link>
    </None>
  </ItemGroup>

  <!-- After publish: ensure empty placeholder dirs exist (FDSBIOS for user
       to drop DISKSYS.ROM into, tools/ffmpeg/ for ffmpeg.exe), and strip
       artifacts the end user doesn't need (~85 MB savings). -->
  <Target Name="AprNesPublishPostProcess" AfterTargets="Publish">
    <MakeDir Directories="$(PublishDir)FDSBIOS;$(PublishDir)tools\ffmpeg" />
    <ItemGroup>
      <_AprNesPublishStrip Include="$(PublishDir)libSkiaSharp.pdb" />
      <_AprNesPublishStrip Include="$(PublishDir)AprNesAvalonia.pdb" />
      <_AprNesPublishStrip Include="$(PublishDir)createdump.exe" />
      <_AprNesPublishStrip Include="$(PublishDir)Microsoft.DiaSymReader.Native.amd64.dll" />
    </ItemGroup>
    <Delete Files="@(_AprNesPublishStrip)" />
  </Target>
</Project>
